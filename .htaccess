Options -Indexes
DirectoryIndex index.php
<FilesMatch "(^\.|\.(sql|sqlite|log|md|pdf)$)">
Require all denied
</FilesMatch>
RewriteEngine On
RewriteRule ^(app|config|database|storage|tests|bin|vendor)(/|$) - [F,L]
RewriteRule ^\. - [F,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ error.php?code=404 [L]
